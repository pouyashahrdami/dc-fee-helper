{
  "manifest_version": 3,
  "name": "DC Fee Helper",
  "version": "0.1.0",
  "description": "Shows your Durham College semester fee estimate next to your account balance.",
  "permissions": ["storage"],
  "host_permissions": ["https://durhamcollege.ca/wp-json/dc/v2/programs/fees/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://ssp.mycampus.ca/StudentSelfService/*"],
      "js": ["content.js"]
    }
  ]
}
